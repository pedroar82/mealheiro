# Copy to .env and fill in from Supabase → Project Settings → API.
# Only the publishable (anon) key goes here — it is shipped inside the app.
# NEVER put the service_role key or the Anthropic API key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional, development only: auto sign-in when running `npx expo start`.
# Ignored in production builds. Leave empty if you prefer to type it.
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=
